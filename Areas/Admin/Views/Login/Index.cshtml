@model BBEcom.Areas.Admin.Models.LoginModel
@{
    Layout = null;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng nhập quản trị | GiftToi</title>
    <link rel="stylesheet" href="~/Content/Admin/css/styles.min.css" />
    <link rel="stylesheet" href="~/Content/Admin/css/admin-modern.css" />
    <link rel="stylesheet" href="~/Content/Admin/css/admin-login-modern.css" />
</head>
<body class="admin-login-page">
    <div class="min-vh-100 d-flex align-items-center justify-content-center radial-gradient">
        <div class="card" style="width:min(92vw,440px)">
            <div class="card-body">
                <h3 class="text-center mb-3">QUẢN TRỊ GIFTTOI</h3>

                @using (Html.BeginForm(
                    "Login", "Login",
                    new { returnUrl = ViewBag.ReturnUrl },
                    FormMethod.Post, null))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        <label class="form-label">Tên đăng nhập</label>
                        @Html.TextBoxFor(x => x.UserName, new
                        {
                            @class = "form-control",
                            autocomplete = "username",
                            autofocus = "autofocus"
                        })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mật khẩu</label>
                        @Html.PasswordFor(x => x.Password, new
                        {
                            @class = "form-control",
                            autocomplete = "current-password"
                        })
                    </div>

                    <div class="form-check mb-4">
                        @Html.CheckBoxFor(x => x.RememberMe, new
                        {
                            @class = "form-check-input",
                            id = "adminRemember"
                        })
                        <label for="adminRemember">Duy trì đăng nhập</label>
                    </div>

                    <button class="btn btn-primary w-100">
                        ĐĂNG NHẬP
                    </button>
                }

                <div class="text-center mt-3">
                    <a href="@Url.Content("~/")">← Trở về cửa hàng</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
