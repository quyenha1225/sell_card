@model Models.EF.News
@{
    ViewBag.Title = "Sửa tin tức" + Model.Title;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-body">

        @using (Html.BeginForm("Edit", "News", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true);

            <div class="form-horizontal">
                <h4>Tin tức mới</h4>
                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3">
                    @*@Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "" })*@
                    <label class="form-label col-md-2">Tiêu đề</label>
                    <div class="col-md-12">
                        @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row col-md-12">
                    <div class="mb-3 col-md-12">

                        @*@Html.LabelFor(model => model.Image, htmlAttributes: new { @class = "form-label col-md-2" })*@
                        <label class="form-label col-md-2">Ảnh bìa</label>
                        <div class="row d-flex">
                            <div class="col-md-12">
                                @Html.EditorFor(model => model.Image, new { htmlAttributes = new { @class = "form-control", @id = "txtImage" } })
                                @Html.ValidationMessageFor(model => model.Image, "", new { @class = "text-danger" })
                            </div>
                        </div>

                    </div>
                </div>

                <div class="mb-3">
                    @*@Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "form-label col-md-2" })*@
                    <label class="form-label col-md-2">Chi tiết</label>
                    <div class="col-md-12">
                        @Html.TextAreaFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" }, @id = "txtDes" })
                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row">
                    <div class="mb-3">
                        <div class="col-md-offset-2 col-md-12">
                            <button type="submit" class="btn btn-primary">Sửa tin tức</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div>
            @Html.ActionLink("Quay lại danh sách", "Index")
        </div>
    </div>
</div>

@section scripts {
    <script>
var editor = CKEDITOR.replace('txtDes', {
            customConfig: '@Url.Content("~/Content/Admin/ckeditor/config.js?v=20261030-pathfix3")'
        })

    </script>
}