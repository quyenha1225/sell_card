@model BBEcom.Areas.Admin.Models.ProductAdminViewModel
@{
    ViewBag.Title = "Sửa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div class="card">
    <div class="card-body">
        <h5 class="card-title fw-semibold mb-4">Cập nhật sản phẩm</h5>
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.Id)
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
            @Html.Partial("_ProductForm", Model)
            <button class="btn btn-primary">CẬP NHẬT</button>
            <a href="@Url.Content("~/Admin/Product")" class="btn btn-outline-secondary">Quay lại</a>
        }
    </div>
</div>
