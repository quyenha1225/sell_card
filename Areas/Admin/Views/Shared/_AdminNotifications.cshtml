@using System
@using System.Collections.Generic
@using System.Data.Entity
@using System.Linq
@using Models.EF

@{
    var notifications =
        new List<Tuple<string, string, string, string, string, DateTime?>>();

    try
    {
        using (var db = new KeyDbContext())
        {
            var pendingOrders = db.Orders
                .AsNoTracking()
                .Where(x => !x.Status)
                .OrderByDescending(x => x.CreatedDate)
                .ThenByDescending(x => x.Id)
                .Take(4)
                .ToList();

            foreach (var order in pendingOrders)
            {
                notifications.Add(Tuple.Create(
                    "order-" + order.Id,
                    "Đơn hàng chờ thanh toán",
                    "#" + order.OrderCode + " · "
                        + BBEcom.Common.CommonHelper.ConvertMoney(
                            order.TotalAmount
                          ) + "đ",
                    "ti ti-receipt",
                    "/Admin",
                    (DateTime?)order.CreatedDate
                ));
            }

            var lowStockProducts = db.Products
                .AsNoTracking()
                .Where(x => x.Status == true)
                .Select(x => new
                {
                    x.Id,
                    x.Name,
                    Stock = x.Giftcard.Count()
                })
                .Where(x => x.Stock <= 2)
                .OrderBy(x => x.Stock)
                .ThenBy(x => x.Name)
                .Take(3)
                .ToList();

            foreach (var product in lowStockProducts)
            {
                notifications.Add(Tuple.Create(
                    "stock-" + product.Id,
                    "Sắp hết GiftCode",
                    product.Name + " còn " + product.Stock + " code",
                    "ti ti-key",
                    "/Admin/Gift",
                    (DateTime?)DateTime.Now
                ));
            }

            var latestNews = db.News
                .AsNoTracking()
                .OrderByDescending(x => x.CreateDate)
                .ThenByDescending(x => x.Id)
                .Take(2)
                .ToList();

            foreach (var news in latestNews)
            {
                notifications.Add(Tuple.Create(
                    "news-" + news.Id,
                    "Tin tức mới",
                    news.Title ?? "Bài viết mới",
                    "ti ti-news",
                    "/Admin/News/Edit/" + news.Id,
                    news.CreateDate
                ));
            }

            var latestProducts = db.Products
                .AsNoTracking()
                .OrderByDescending(x => x.CreatedDate)
                .ThenByDescending(x => x.Id)
                .Take(2)
                .ToList();

            foreach (var product in latestProducts)
            {
                notifications.Add(Tuple.Create(
                    "product-" + product.Id,
                    "Sản phẩm mới",
                    product.Name ?? "Sản phẩm mới",
                    "ti ti-package",
                    "/Admin/Product/Edit/" + product.Id,
                    product.CreatedDate
                ));
            }
        }
    }
    catch
    {
        // Không để lỗi truy vấn thông báo làm hỏng toàn bộ trang quản trị.
    }

    notifications = notifications
        .OrderByDescending(x => x.Item6 ?? DateTime.MinValue)
        .Take(8)
        .ToList();
}

<li class="nav-item dropdown admin-notification-wrap">
    <button type="button"
            class="nav-link nav-icon-hover admin-notification-toggle"
            id="adminNotificationToggle"
            data-bs-toggle="dropdown"
            data-bs-auto-close="outside"
            aria-expanded="false"
            aria-label="Mở thông báo">
        <i class="ti ti-bell-ringing"></i>

        @if (notifications.Any())
        {
            <span class="admin-notification-count"
                  data-notification-count>
                @notifications.Count
            </span>
        }
    </button>

    <div class="dropdown-menu dropdown-menu-start admin-notification-menu"
         aria-labelledby="adminNotificationToggle">
        <div class="admin-notification-header">
            <div>
                <span>TRUNG TÂM THÔNG BÁO</span>
                <h3>Hoạt động cần chú ý</h3>
            </div>

            <button type="button"
                    class="admin-mark-read"
                    data-mark-all-notifications>
                Đã đọc hết
            </button>
        </div>

        <div class="admin-notification-list">
            @if (notifications.Any())
            {
                foreach (var item in notifications)
                {
                    <a class="admin-notification-item"
                       href="@item.Item5"
                       data-notification-id="@item.Item1">
                        <span class="admin-notification-icon">
                            <i class="@item.Item4"></i>
                        </span>

                        <span class="admin-notification-copy">
                            <strong>@item.Item2</strong>
                            <span>@item.Item3</span>
                            <small>
                                @(item.Item6.HasValue
                                    ? item.Item6.Value.ToString("dd/MM/yyyy HH:mm")
                                    : "Vừa cập nhật")
                            </small>
                        </span>

                        <i class="admin-unread-dot"
                           aria-hidden="true"></i>
                    </a>
                }
            }
            else
            {
                <div class="admin-notification-empty">
                    <i class="ti ti-bell-check"></i>
                    <strong>Không có thông báo mới</strong>
                    <span>Mọi dữ liệu hiện đang ổn định.</span>
                </div>
            }
        </div>

        <div class="admin-notification-footer">
            <a href="/Admin">Mở bảng điều khiển</a>
        </div>
    </div>
</li>
