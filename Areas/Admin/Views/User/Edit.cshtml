@model BBEcom.Areas.Admin.Models.UserAdminViewModel
@{
    ViewBag.Title = "Sửa người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div class="card"><div class="card-body">
    <h5 class="mb-4">Cập nhật người dùng</h5>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(x => x.Id)
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
        @Html.Partial("_UserForm", Model)
        <button class="btn btn-primary">CẬP NHẬT</button>
        <a href="@Url.Content("~/Admin/User")" class="btn btn-outline-secondary">Quay lại</a>
    }
</div></div>
