@using PagedList
@using PagedList.Mvc
@model IPagedList<Models.EF.Account>
@{
    ViewBag.Title = "Người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var pageSize = ViewBag.PageSize == null ? 10 : Convert.ToInt32(ViewBag.PageSize);
}
<div class="card"><div class="card-body p-4">
    <div class="d-flex justify-content-between mb-4">
        <h5>Danh sách người dùng</h5>
        <a href="@Url.Content("~/Admin/User/Create")" class="btn btn-success">Thêm người dùng</a>
    </div>

    @using (Html.BeginForm("Index", "User", FormMethod.Get, new { @class = "row g-2 mb-4" }))
    {
        <div class="col-md-9">
            <input name="txtSearch" value="@ViewBag.Search"
                   class="form-control" placeholder="Tên, email..." />
        </div>
        <div class="col-md-2">
            <select name="pageSize" class="form-select">
                @foreach (var size in new[] { 10, 20, 50, 100 })
                {
                    <option value="@size" @(pageSize == size ? "selected" : "")>@size dòng</option>
                }
            </select>
        </div>
        <div class="col-md-1"><button class="btn btn-primary w-100">Tìm</button></div>
    }

    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr>
                <th>ID</th><th>Tài khoản</th><th>Họ tên</th><th>Email</th>
                <th>Quyền</th><th>Trạng thái</th><th>Thao tác</th>
            </tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td><td>@item.UserName</td><td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@(item.IsAdmin ? "Admin" : "Khách hàng")</td>
                        <td>@(item.Status ? "Hoạt động" : "Khóa")</td>
                        <td>
                            <a href="@Url.Content("~/Admin/User/Edit/" + item.Id)" class="btn btn-sm btn-primary">Sửa</a>
                            @using (Html.BeginForm("Delete", "User", FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="btn btn-sm btn-danger"
                                        onclick="return confirm('Bạn có chắc muốn xóa?');">
                                    Xóa
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @Html.PagedListPager(Model, page => Url.Action("Index", new
    {
        page = page,
        pageSize = pageSize,
        txtSearch = ViewBag.Search
    }))
</div></div>
