@model IEnumerable<BBEcom.Models.Cart>
@using BBEcom.Common

@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var list =
        Model == null
            ? new List<BBEcom.Models.Cart>()
            : Model.ToList();

    var total = list.Sum(x =>
        CommonHelper.GetSellingPrice(x.product)
        * x.Quantity
    );
}

<link rel="stylesheet"
      href="/Content/Client/css/storefront-part1.css?v=20260801-1" />

@section jsFooter {
    <script src="/Content/Client/js/CartController.js?v=20260801-1"></script>
}

<div class="page-title-area">
    <div class="container">
        <div class="page-title-content">
            <h1>Giỏ hàng</h1>
            <ul>
                <li><a href="/">Trang chủ</a></li>
                <li>Giỏ hàng</li>
            </ul>
        </div>
    </div>
</div>

<div class="cart-area ptb-100">
    <div class="container">
        @if (TempData["CartError"] != null)
        {
            <div class="alert alert-danger">
                @TempData["CartError"]
            </div>
        }

        <div id="cartAntiForgery" class="d-none">
            @Html.AntiForgeryToken()
        </div>

        @if (list.Any())
        {
            <div class="cart-shell">
                <div class="cart-table table-responsive">
                    <table class="table clean-cart-table">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in list)
                            {
                                var unitPrice =
                                    CommonHelper.GetSellingPrice(
                                        item.product
                                    );

                                var image =
                                    CommonHelper.ResolveProductImage(
                                        item.product.Alias,
                                        item.product.Images
                                    );

                                <tr data-product-id="@item.product.Id">
                                    <td class="product-thumbnail">
                                        <a href="/san-pham/@item.product.Alias-@item.product.Id">
                                            <img src="@image"
                                                 alt="@item.product.Name"
                                                 onerror="this.onerror=null;this.src='/Content/Client/img/error.png';" />
                                            <h3>@item.product.Name</h3>
                                        </a>
                                    </td>

                                    <td class="unit-price"
                                        data-value="@unitPrice">
                                        @CommonHelper.ConvertMoney(unitPrice)đ
                                    </td>

                                    <td class="product-quantity">
                                        <div class="input-counter">
                                            <button type="button"
                                                    class="minus-btn"
                                                    aria-label="Giảm số lượng">
                                                <i class="bx bx-minus"></i>
                                            </button>

                                            <input type="number"
                                                   min="1"
                                                   value="@item.Quantity"
                                                   data-id="@item.product.Id"
                                                   class="productQuantity" />

                                            <button type="button"
                                                    class="plus-btn"
                                                    aria-label="Tăng số lượng">
                                                <i class="bx bx-plus"></i>
                                            </button>
                                        </div>
                                    </td>

                                    <td class="line-total">
                                        @CommonHelper.ConvertMoney(
                                            item.Quantity * unitPrice
                                        )đ
                                    </td>

                                    <td>
                                        <button type="button"
                                                data-id="@item.product.Id"
                                                class="remove btnDelete"
                                                aria-label="Xóa sản phẩm">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="cart-footer-actions">
                    <button id="btnDeleteCart"
                            type="button"
                            class="clear-cart-btn">
                        Xóa tất cả
                    </button>

                    <div class="cart-totals clean-cart-totals">
                        <ul>
                            <li>
                                Tổng cộng
                                <span id="cartGrandTotal">
                                    @CommonHelper.ConvertMoney(total)đ
                                </span>
                            </li>
                        </ul>

                        <a href="/thanh-toan"
                           class="default-btn">
                            <span>Thanh toán ngay</span>
                        </a>

                        <small>
                            Giá và tồn kho được kiểm tra lại
                            trước khi tạo mã QR.
                        </small>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="empty-storefront">
                <i class="bx bx-cart"></i>
                <h3>Giỏ hàng đang trống</h3>
                <p>Chọn sản phẩm phù hợp để tiếp tục.</p>
                <a href="@Url.Action("Search", "Product")"
                   class="default-btn">
                    <span>Xem sản phẩm</span>
                </a>
            </div>
        }
    </div>
</div>
