@model BBEcom.Models.ViewModels.SePayCheckoutViewModel
@{ Layout = null; }
<!doctype html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Đang chuyển đến SePay</title><style>body{min-height:100vh;display:grid;place-items:center;margin:0;background:#f0faff;font-family:Segoe UI,Arial,sans-serif;color:#17283b}.box{text-align:center;padding:40px;border-radius:22px;background:#fff;box-shadow:0 22px 60px rgba(25,100,140,.13)}.loader{width:48px;height:48px;margin:0 auto 20px;border:5px solid #dff3fb;border-top-color:#249ed4;border-radius:50%;animation:s .8s linear infinite}@@keyframes s{to{transform:rotate(360deg)}}</style></head><body><div class="box"><div class="loader"></div><h1>Đang chuyển đến SePay</h1><p>Vui lòng không đóng cửa sổ này.</p><form id="sepayForm" action="@Model.CheckoutUrl" method="post">@foreach(var field in Model.Fields){<input type="hidden" name="@field.Key" value="@field.Value"/>}<input type="hidden" name="signature" value="@Model.Signature"/><noscript><button type="submit">Tiếp tục thanh toán</button></noscript></form></div><script>document.getElementById('sepayForm').submit();</script></body></html>
