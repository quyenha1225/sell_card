@model BBEcom.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="/Content/Client/css/auth-part2.css?v=20260801-1" />

<div class="profile-authentication-area ptb-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="login-form auth-card">
                    <h2>QUÊN MẬT KHẨU</h2>
                    <p>Nhập email đã đăng ký để nhận mã OTP.</p>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="form-group">
                            <label>Email</label>
                            @Html.TextBoxFor(x => x.Email, new
                            {
                                @class = "form-control",
                                type = "email",
                                autocomplete = "email"
                            })
                            @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
                        </div>

                        <button type="submit" class="auth-primary-btn">
                            Gửi mã OTP
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
