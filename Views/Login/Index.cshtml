@model BBEcom.Areas.Admin.Models.LoginModel
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="@Url.Content("~/Content/Client/css/auth-part2.css?v=20260801-1")" />

<div class="profile-authentication-area ptb-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-10">
                <div class="login-form auth-card">
                    <h2>ĐĂNG NHẬP</h2>

                    @if (TempData["LoginSuccess"] != null)
                    {
                        <div class="alert alert-success">@TempData["LoginSuccess"]</div>
                    }
                    @if (TempData["PasswordResetSuccess"] != null)
                    {
                        <div class="alert alert-success">@TempData["PasswordResetSuccess"]</div>
                    }
                    @if (TempData["LoginError"] != null)
                    {
                        <div class="alert alert-danger">@TempData["LoginError"]</div>
                    }

                    @using (Html.BeginForm(
                        "Login", "Login",
                        new { returnUrl = ViewBag.ReturnUrl },
                        FormMethod.Post,
                        new { autocomplete = "on" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="form-group">
                            <label>Tên đăng nhập</label>
                            @Html.TextBoxFor(x => x.UserName, new
                            {
                                @class = "form-control",
                                autocomplete = "username",
                                autofocus = "autofocus"
                            })
                            @Html.ValidationMessageFor(x => x.UserName, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            <label>Mật khẩu</label>
                            @Html.PasswordFor(x => x.Password, new
                            {
                                @class = "form-control",
                                autocomplete = "current-password"
                            })
                            @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger" })
                        </div>

                        <div class="auth-options">
                            <div class="form-check">
                                @Html.CheckBoxFor(x => x.RememberMe, new
                                {
                                    @class = "form-check-input",
                                    id = "remember-me"
                                })
                                <label for="remember-me">Duy trì đăng nhập</label>
                            </div>

                            <a href="@Url.Action("ForgotPassword", "Login")">
                                Quên mật khẩu?
                            </a>
                        </div>

                        <button type="submit" class="auth-primary-btn">
                            Đăng nhập
                        </button>
                    }

                    <div class="auth-divider"><span>hoặc</span></div>

                    <a class="google-auth-btn"
                       href="@Url.Action("Google", "Login", new { returnUrl = ViewBag.ReturnUrl })">
                        <span class="google-mark">G</span>
                        Đăng nhập bằng Google
                    </a>

                    <p class="auth-bottom-link">
                        Chưa có tài khoản?
                        <a href="@Url.Action("Index", "Register", new { returnUrl = ViewBag.ReturnUrl })">
                            Đăng ký ngay
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>


@section jsFooter {
    <script>
        // Khi quay Back về form đăng nhập sau OAuth, Chrome có thể phục hồi
        // nguyên form cùng Anti-Forgery token của anonymous user từ BFCache.
        // Reload buộc server kiểm tra JWT mới và redirect người đã đăng nhập.
        window.addEventListener('pageshow', function (event) {
            var nav = window.performance &&
                performance.getEntriesByType &&
                performance.getEntriesByType('navigation')[0];

            if (event.persisted || (nav && nav.type === 'back_forward')) {
                window.location.reload();
            }
        });
    </script>
}
