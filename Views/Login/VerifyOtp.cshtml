@model BBEcom.Models.ViewModels.VerifyOtpViewModel
@{
    ViewBag.Title = "Xác minh OTP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="/Content/Client/css/auth-part2.css?v=20260801-1" />

<div class="profile-authentication-area ptb-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="login-form auth-card">
                    <h2>XÁC MINH OTP</h2>

                    @if (TempData["OtpSent"] != null)
                    {
                        <div class="alert alert-success">@TempData["OtpSent"]</div>
                    }

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(x => x.Email)
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="form-group">
                            <label>Mã OTP 6 số</label>
                            @Html.TextBoxFor(x => x.Otp, new
                            {
                                @class = "form-control otp-input",
                                inputmode = "numeric",
                                maxlength = "6",
                                autocomplete = "one-time-code"
                            })
                            @Html.ValidationMessageFor(x => x.Otp, "", new { @class = "text-danger" })
                        </div>

                        <button type="submit" class="auth-primary-btn">
                            Xác minh
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
