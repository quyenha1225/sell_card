@model IEnumerable<Models.EF.News>
@using System.Linq

@{
    ViewBag.Title = "Tin tức";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var news = (Model ?? Enumerable.Empty<Models.EF.News>()).ToList();
    var first = news.FirstOrDefault();
}

<link rel="stylesheet" href="/Content/Client/css/news-modern.css?v=20260801-2" />

<main class="news-page">
    <header class="news-index-hero">
        <div class="container">
            <span class="news-kicker">KIẾN THỨC &amp; CẬP NHẬT</span>
            <h1>Tin tức GiftToi</h1>
            <p>
                Hướng dẫn sử dụng, kinh nghiệm bảo mật và những thông tin
                hữu ích về sản phẩm kỹ thuật số.
            </p>
        </div>
    </header>

    <section class="news-list-section">
        <div class="container">
            @if (first != null)
            {
                var firstImage =
                    BBEcom.Common.CommonHelper.ResolveNewsImage(
                        first.Alias,
                        first.Title,
                        first.Image
                    );

                <article class="featured-news">
                    <a href="/tin-tuc/@first.Alias-@first.Id">
                        <img src="@firstImage"
                             alt="@first.Title"
                             loading="eager"
                             onerror="this.onerror=null;this.src='/Content/Client/img/error.png';" />
                    </a>

                    <div>
                        <span class="news-label">BÀI VIẾT NỔI BẬT</span>

                        <h2>
                            <a href="/tin-tuc/@first.Alias-@first.Id">
                                @first.Title
                            </a>
                        </h2>

                        <p>
                            @(first.CreateDate.HasValue
                                ? first.CreateDate.Value.ToString("dd/MM/yyyy")
                                : "Tin mới")
                            · 5 phút đọc
                        </p>

                        <a class="read-more"
                           href="/tin-tuc/@first.Alias-@first.Id">
                            Đọc bài viết
                            <i class="bx bx-right-arrow-alt"></i>
                        </a>
                    </div>
                </article>
            }

            @if (news.Count > 1)
            {
                <div class="news-section-title">
                    <div>
                        <span>BÀI VIẾT MỚI</span>
                        <h2>Khám phá thêm</h2>
                    </div>
                </div>

                <div class="news-grid">
                    @foreach (var item in news.Skip(1))
                    {
                        var image =
                            BBEcom.Common.CommonHelper.ResolveNewsImage(
                                item.Alias,
                                item.Title,
                                item.Image
                            );

                        <article class="news-card">
                            <a class="news-card-image"
                               href="/tin-tuc/@item.Alias-@item.Id">
                                <img src="@image"
                                     alt="@item.Title"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='/Content/Client/img/error.png';" />
                            </a>

                            <div class="news-card-body">
                                <span>
                                    @(item.CreateDate.HasValue
                                        ? item.CreateDate.Value.ToString("dd/MM/yyyy")
                                        : "Tin mới")
                                </span>

                                <h3>
                                    <a href="/tin-tuc/@item.Alias-@item.Id">
                                        @item.Title
                                    </a>
                                </h3>

                                <a href="/tin-tuc/@item.Alias-@item.Id">
                                    Xem chi tiết
                                    <i class="bx bx-right-arrow-alt"></i>
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }

            @if (!news.Any())
            {
                <div class="news-empty">
                    <i class="bx bx-news"></i>
                    <h2>Chưa có bài viết</h2>
                    <p>Nội dung mới sẽ sớm được cập nhật.</p>
                </div>
            }
        </div>
    </section>
</main>
