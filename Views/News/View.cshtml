@model Models.EF.News
@using System.Collections.Generic

@{
    ViewBag.Title = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var related =
        ViewBag.RelatedNews as IEnumerable<Models.EF.News>
        ?? new List<Models.EF.News>();

    var coverImage =
        BBEcom.Common.CommonHelper.ResolveNewsImage(
            Model.Alias,
            Model.Title,
            Model.Image
        );
}

<link rel="stylesheet" href="@Url.Content("~/Content/Client/css/news-modern.css?v=20260801-2")" />

<main class="news-page">
    <header class="news-detail-hero">
        <div class="container">
            <nav>
                <a href="@Url.Content("~/")">Trang chủ</a>
                <i class="bx bx-chevron-right"></i>
                <a href="@Url.Content("~/tin-tuc")">Tin tức</a>
            </nav>

            <span class="news-kicker">GIFTTOI JOURNAL</span>
            <h1>@Model.Title</h1>

            <div class="article-meta">
                <span>
                    <i class="bx bx-calendar"></i>
                    @(Model.CreateDate.HasValue
                        ? Model.CreateDate.Value.ToString("dd/MM/yyyy")
                        : "Đang cập nhật")
                </span>
                <span><i class="bx bx-time-five"></i> 5 phút đọc</span>
            </div>
        </div>
    </header>

    <div class="container article-layout">
        <article class="article-card">
            <img class="article-cover"
                 src="@(Url.Content(Convert.ToString(coverImage).StartsWith("/Content/", StringComparison.OrdinalIgnoreCase) ? "~" + Convert.ToString(coverImage) : Convert.ToString(coverImage)))"
                 alt="@Model.Title"
                 loading="eager"
                 onerror="this.onerror=null;this.src='@Url.Content("~/Content/Client/img/error.png")';" />

            <div class="article-body">
                @if (!String.IsNullOrWhiteSpace(Model.Description))
                {
                    @Html.Raw(Model.Description)
                }
                else
                {
                    <p>Nội dung bài viết đang được cập nhật.</p>
                }
            </div>

            <footer class="article-footer">
                <span>
                    <i class="bx bx-purchase-tag-alt"></i>
                    Tin tức · Hướng dẫn · Gift Card
                </span>

                <a href="@Url.Content("~/tin-tuc")">
                    <i class="bx bx-left-arrow-alt"></i>
                    Xem tất cả bài viết
                </a>
            </footer>
        </article>

        <aside class="related-news">
            <div class="related-box">
                <span class="aside-label">ĐỌC TIẾP</span>
                <h3>Bài viết mới</h3>

                @foreach (var item in related)
                {
                    var image =
                        BBEcom.Common.CommonHelper.ResolveNewsImage(
                            item.Alias,
                            item.Title,
                            item.Image
                        );

                    <a class="related-item"
                       href="@Url.Content("~/tin-tuc/" + item.Alias + "-" + item.Id)">
                        <img src="@(Url.Content(Convert.ToString(image).StartsWith("/Content/", StringComparison.OrdinalIgnoreCase) ? "~" + Convert.ToString(image) : Convert.ToString(image)))"
                             alt="@item.Title"
                             loading="lazy"
                             onerror="this.onerror=null;this.src='@Url.Content("~/Content/Client/img/error.png")';" />

                        <span>
                            <strong>@item.Title</strong>
                            <small>
                                @(item.CreateDate.HasValue
                                    ? item.CreateDate.Value.ToString("dd/MM/yyyy")
                                    : "Tin mới")
                            </small>
                        </span>
                    </a>
                }
            </div>
        </aside>
    </div>
</main>
