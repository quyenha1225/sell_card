@model Models.EF.News
@{
    ViewBag.Title = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var related = ViewBag.RelatedNews as IEnumerable<Models.EF.News>;
}
<link rel="stylesheet" href="/Content/Client/css/news-modern.css" />
<main class="news-page">
    <header class="news-detail-hero"><div class="container"><nav><a href="/">Trang chủ</a><i class="bx bx-chevron-right"></i><a href="/tin-tuc">Tin tức</a></nav><span class="news-kicker">GIFTTOI JOURNAL</span><h1>@Model.Title</h1><div class="article-meta"><span><i class="bx bx-calendar"></i> @(Model.CreateDate.HasValue ? Model.CreateDate.Value.ToString("dd/MM/yyyy") : "Đang cập nhật")</span><span><i class="bx bx-time-five"></i> 5 phút đọc</span></div></div></header>
    <div class="container article-layout">
        <article class="article-card">
            <img class="article-cover" src="@Model.Image" alt="@Model.Title" />
            <div class="article-body">@Html.Raw(Model.Description)</div>
            <footer class="article-footer"><span><i class="bx bx-purchase-tag-alt"></i> Tin tức · Hướng dẫn · Gift Card</span><a href="/tin-tuc"><i class="bx bx-left-arrow-alt"></i> Xem tất cả bài viết</a></footer>
        </article>
        <aside class="related-news"><div class="related-box"><span class="aside-label">ĐỌC TIẾP</span><h3>Bài viết mới</h3>@if (related != null){foreach(var item in related){<a class="related-item" href="/tin-tuc/@item.Alias-@item.Id"><img src="@item.Image" alt="@item.Title"/><span><strong>@item.Title</strong><small>@(item.CreateDate.HasValue ? item.CreateDate.Value.ToString("dd/MM/yyyy") : "Tin mới")</small></span></a>}}</div></aside>
    </div>
</main>
