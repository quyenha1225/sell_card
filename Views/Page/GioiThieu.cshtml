@{ ViewBag.Title = "Giới thiệu GiftToi"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<main class="about-modern-page">
    <section class="about-modern-hero">
        <div class="about-square about-square-one"><span></span></div><div class="about-square about-square-two"><span></span></div>
        <div class="container about-hero-grid"><div class="about-copy reveal-item"><span class="about-kicker">CÂU CHUYỆN GIFTTOI</span><h1>Thế giới sản phẩm số,<br/><em>đơn giản và đáng tin cậy.</em></h1><p>GiftToi được xây dựng bởi những người yêu game và công nghệ, với mong muốn giúp mọi khách hàng tiếp cận gift card, tiện ích số nhanh chóng, minh bạch và an tâm.</p><div class="about-actions"><a href="/#storefront-products">Khám phá sản phẩm <i class="bx bx-right-arrow-alt"></i></a><a href="/tin-tuc">Đọc tin mới</a></div></div><div class="about-visual reveal-item"><div class="visual-orbit"><img src="/Content/Client/img/about/ab3.png" alt="Đội ngũ GiftToi"/><span class="orbit-dot dot-one"></span><span class="orbit-dot dot-two"></span></div></div></div>
    </section>
    <section class="about-values"><div class="container"><div class="about-heading reveal-item"><span>GIÁ TRỊ CỐT LÕI</span><h2>Trải nghiệm tốt bắt đầu từ sự tử tế</h2></div><div class="value-grid"><article class="reveal-item"><i class="bx bx-bolt-circle"></i><strong>Nhanh chóng</strong><p>Tối ưu từng bước từ chọn sản phẩm đến nhận code.</p></article><article class="reveal-item"><i class="bx bx-shield-quarter"></i><strong>An toàn</strong><p>Thông tin rõ ràng và hỗ trợ khi giao dịch gặp vấn đề.</p></article><article class="reveal-item"><i class="bx bx-heart"></i><strong>Tận tâm</strong><p>Khách hàng hôm nay là người đồng hành lâu dài của chúng tôi.</p></article></div></div></section>
    <section class="about-story"><div class="container story-grid"><div class="story-image reveal-item"><img src="/Content/Client/img/about/ab4.png" alt="GiftToi đồng hành cùng khách hàng"/><div class="experience-chip"><strong>24/7</strong><span>Sẵn sàng hỗ trợ</span></div></div><div class="story-copy reveal-item"><span>ĐỒNG ĐỘI CỦA BẠN</span><h2>Không chỉ bán sản phẩm,<br/>chúng tôi xây dựng niềm tin.</h2><p>Đội ngũ GiftToi hiểu sản phẩm vì chính chúng tôi cũng là người sử dụng. Mọi tư vấn đều hướng tới nhu cầu thực tế, chi phí phù hợp và trải nghiệm lâu dài.</p><ul><li><i class="bx bx-check"></i> Sản phẩm kỹ thuật số chọn lọc</li><li><i class="bx bx-check"></i> Quy trình mua hàng minh bạch</li><li><i class="bx bx-check"></i> Đồng hành trong suốt quá trình sử dụng</li></ul></div></div></section>
</main>
