@model Models.EF.Category
@{
    ViewBag.Title = "Danh mục " + Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var sort =
        ViewBag.Sort as string
        ?? "latest";

    var page =
        ViewBag.Page == null
            ? 1
            : Convert.ToInt32(ViewBag.Page);

    var pageSize =
        ViewBag.PageSize == null
            ? 8
            : Convert.ToInt32(ViewBag.PageSize);
}

<link rel="stylesheet"
      href="@Url.Content("~/Content/Client/css/storefront-part1.css?v=20260801-1")" />

<div class="page-title-area">
    <div class="container">
        <div class="page-title-content">
            <h1>@Model.Name</h1>
            <ul>
                <li>
                    <a href="@Url.Action("Index", "Home")">
                        Trang chủ
                    </a>
                </li>
                <li>@Model.Name</li>
            </ul>
        </div>
    </div>
</div>

<section class="products-area ptb-100">
    <div class="container">
        <div class="storefront-toolbar">
            <div>
                <strong>
                    @ViewBag.CategoryProductCount
                </strong>
                sản phẩm đang hoạt động.
            </div>

            @using (Html.BeginForm(
                "Category",
                "Product",
                FormMethod.Get,
                new { id = "categorySortForm" }))
            {
                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <div class="toolbar-controls">
                    <label for="sort">Sắp xếp</label>
                    <select id="sort"
                            name="sort"
                            onchange="this.form.submit()">
                        <option value="latest"
                                @(sort == "latest" ? "selected" : "")>
                            Mới nhất
                        </option>
                        <option value="price_asc"
                                @(sort == "price_asc" ? "selected" : "")>
                            Giá thấp đến cao
                        </option>
                        <option value="price_desc"
                                @(sort == "price_desc" ? "selected" : "")>
                            Giá cao đến thấp
                        </option>
                        <option value="name_asc"
                                @(sort == "name_asc" ? "selected" : "")>
                            Tên A–Z
                        </option>
                        <option value="sale"
                                @(sort == "sale" ? "selected" : "")>
                            Đang giảm giá
                        </option>
                    </select>

                    <label for="pageSize">Hiển thị</label>
                    <select id="pageSize"
                            name="pageSize"
                            onchange="this.form.submit()">
                        @foreach (var size in new[] { 8, 12, 16, 24 })
                        {
                            <option value="@size"
                                    @(pageSize == size ? "selected" : "")>
                                @size
                            </option>
                        }
                    </select>
                </div>
            }
        </div>

        <div class="row justify-content-center">
            @{
                Html.RenderAction(
                    "Products",
                    "Product",
                    new
                    {
                        id = Model.Id,
                        sort = sort,
                        page = page,
                        pageSize = pageSize
                    }
                );
            }
        </div>
    </div>
</section>
