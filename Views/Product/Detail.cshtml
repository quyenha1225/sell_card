@model Models.EF.Product
@{
    ViewBag.Title = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var stock = (int)(ViewBag.Stock ?? 0);
    var hasSale = Model.PriceSale.HasValue && Model.PriceSale.Value > 0 && Model.PriceSale.Value < Model.Price;
    var currentPrice = hasSale ? Model.PriceSale.Value : Model.Price;
    var discount = hasSale ? (int)Math.Round((Model.Price - Model.PriceSale.Value) * 100m / Model.Price) : 0;
    var isLoggedIn = Session[BBEcom.Common.CommonConstants.USER_SESSION] != null;
    var productUrl = Url.Action("Detail", "Product", new { alias = Model.Alias, id = Model.Id });
}

<link rel="stylesheet" href="/Content/Client/css/product-detail.css?v=20260725-2" />

<main class="product-detail-page">
    <section class="product-breadcrumb">
        <div class="container">
            <nav aria-label="Đường dẫn">
                <a href="/">Trang chủ</a><i class="bx bx-chevron-right"></i>
                @if (Model.Category != null)
                {
                    <a href="/danh-muc/@Model.Category.Alias-@Model.Category.Id">@Model.Category.Name</a><i class="bx bx-chevron-right"></i>
                }
                <span>@Model.Name</span>
            </nav>
        </div>
    </section>

    <section class="product-hero">
        <div class="container">
            @if (TempData["CartError"] != null)
            {
                <div class="product-alert"><i class="bx bx-error-circle"></i>@TempData["CartError"]</div>
            }
            <div class="product-card">
                <div class="product-visual reveal-item">
                    @if (hasSale)
                    {
                        <span class="sale-badge">-@discount%</span>
                    }
                    <div class="image-frame">
                        <img src="@Model.Images" alt="@Model.Name" id="productImage" />
                    </div>
                    <div class="image-note"><i class="bx bx-zoom-in"></i> Di chuột để xem sản phẩm rõ hơn</div>
                </div>

                <div class="product-summary reveal-item">
                    <div class="eyebrow">SẢN PHẨM KỸ THUẬT SỐ</div>
                    <h1>@Model.Name</h1>
                    <div class="rating-row">
                        <span class="stars"><i class="bx bxs-star"></i><i class="bx bxs-star"></i><i class="bx bxs-star"></i><i class="bx bxs-star"></i><i class="bx bxs-star"></i></span>
                        <span>Giao code tự động</span><span class="dot"></span><span>Mã SP: KSP@(Model.Id)</span>
                    </div>
                    <div class="price-panel">
                        <span class="current-price">@BBEcom.Common.CommonHelper.ConvertMoney(currentPrice)đ</span>
                        @if (hasSale)
                        {
                            <span class="original-price">@BBEcom.Common.CommonHelper.ConvertMoney(Model.Price)đ</span>
                            <span class="saving">Tiết kiệm @BBEcom.Common.CommonHelper.ConvertMoney(Model.Price - currentPrice)đ</span>
                        }
                    </div>

                    <p class="product-lead">Nhận mã sản phẩm nhanh chóng sau khi thanh toán. Code và thông tin đơn hàng được gửi qua email, đồng thời lưu trong lịch sử mua hàng của bạn.</p>

                    <div class="benefit-grid">
                        <div><i class="bx bx-bolt-circle"></i><span><strong>Giao code nhanh</strong>Nhận ngay sau thanh toán</span></div>
                        <div><i class="bx bx-shield-quarter"></i><span><strong>Mua hàng an tâm</strong>Hỗ trợ khi code có lỗi</span></div>
                        <div><i class="bx bx-support"></i><span><strong>Luôn có hỗ trợ</strong>Giải đáp trong quá trình dùng</span></div>
                    </div>

                    <div class="stock-line @(stock > 0 ? "in-stock" : "out-stock")">
                        <span class="stock-dot"></span>
                        @(stock > 0 ? "Còn hàng - " + stock + " code có sẵn" : "Sản phẩm tạm hết hàng")
                    </div>

                    @if (isLoggedIn)
                    {
                        using (Html.BeginForm("AddItem", "Cart", FormMethod.Post, new { @class = "purchase-box", id = "addToCartForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productID" value="@Model.Id" />
                            <div class="quantity-wrap">
                                <label for="productQuantity">Số lượng</label>
                                <div class="quantity-control">
                                    <button type="button" data-action="minus" aria-label="Giảm số lượng"><i class="bx bx-minus"></i></button>
                                    <input id="productQuantity" name="quantity" type="number" value="1" min="1" max="@Math.Max(stock, 1)" inputmode="numeric" />
                                    <button type="button" data-action="plus" aria-label="Tăng số lượng"><i class="bx bx-plus"></i></button>
                                </div>
                            </div>
                            <div class="purchase-actions">
                                <button type="submit" class="add-cart-btn secondary-buy-btn" @(stock < 1 ? "disabled" : null)>
                                    <i class="bx bx-cart-add"></i><span>@(stock > 0 ? "Thêm vào giỏ" : "Tạm hết hàng")</span>
                                </button>
                                <button type="submit" formaction="@Url.Action("BuyNow", "Cart")" class="add-cart-btn buy-now-btn" @(stock < 1 ? "disabled" : null)>
                                    <i class="bx bx-bolt-circle"></i><span>Mua ngay</span>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="purchase-box login-purchase-box">
                            <div class="login-prompt"><small>Mua sản phẩm này</small><strong>Đăng nhập để tiếp tục</strong></div>
                            <a class="add-cart-btn login-buy-btn" href="@Url.Action("Index", "Login", new { returnUrl = productUrl })"><i class="bx bx-log-in-circle"></i><span>Đăng nhập ngay</span></a>
                        </div>
                    }

                    <div class="meta-row">
                        <span><i class="bx bx-category"></i> Danh mục</span>
                        @if (Model.Category != null)
                        {<a href="/danh-muc/@Model.Category.Alias-@Model.Category.Id">@Model.Category.Name</a>}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="product-information">
        <div class="container">
            <div class="info-layout">
                <article class="detail-content reveal-item">
                    <div class="section-heading"><span>THÔNG TIN SẢN PHẨM</span><h2>Chi tiết và hướng dẫn sử dụng</h2><p>Mọi thông tin cần thiết trước khi bạn mua và kích hoạt sản phẩm.</p></div>
                    <div class="rich-description">
                        @if (!String.IsNullOrWhiteSpace(Model.Detail))
                        {@Html.Raw(Model.Detail)}
                        else
                        {<p>Thông tin chi tiết của sản phẩm đang được cập nhật. Vui lòng liên hệ bộ phận hỗ trợ nếu bạn cần tư vấn trước khi mua.</p>}
                    </div>
                </article>
                <aside class="buy-guide reveal-item">
                    <h3>Quy trình nhận code</h3>
                    <ol>
                        <li><span>1</span><div><strong>Thêm vào giỏ hàng</strong><p>Chọn đúng số lượng bạn cần.</p></div></li>
                        <li><span>2</span><div><strong>Thanh toán an toàn</strong><p>Hoàn tất bằng phương thức phù hợp.</p></div></li>
                        <li><span>3</span><div><strong>Nhận và kích hoạt</strong><p>Kiểm tra email hoặc lịch sử mua hàng.</p></div></li>
                    </ol>
                    <div class="support-box"><i class="bx bx-message-rounded-dots"></i><div><small>Cần tư vấn?</small><strong>Liên hệ hỗ trợ ngay</strong></div></div>
                </aside>
            </div>
        </div>
    </section>
</main>

@section jsFooter {
    <script src="/Content/Client/js/product-detail.js?v=20260725-2"></script>
}
