@model Models.EF.Product
@{
    ViewBag.Title = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var stock =
        (int)(ViewBag.Stock ?? 0);

    var hasSale =
        BBEcom.Common.CommonHelper.HasValidSale(Model);

    var currentPrice =
        BBEcom.Common.CommonHelper.GetSellingPrice(Model);

    var discount =
        BBEcom.Common.CommonHelper.GetDiscountPercent(Model);

    var imageUrl =
        BBEcom.Common.CommonHelper.ResolveProductImage(
            Model.Alias,
            Model.Images
        );

    // Toàn bộ đăng nhập hiện dùng JWT + GiftToi.AccessToken.
    // Không kiểm tra USER_SESSION cũ nữa.
    var isLoggedIn =
        BBEcom.Common.Auth.CurrentUser.IsAuthenticated;

    var productUrl =
        Url.Action(
            "Detail",
            "Product",
            new
            {
                alias = Model.Alias,
                id = Model.Id
            }
        );
}

<link rel="stylesheet"
      href="/Content/Client/css/product-detail.css?v=20260725-2" />
<link rel="stylesheet"
      href="/Content/Client/css/storefront-part1.css?v=20260801-1" />

<main class="product-detail-page">
    <section class="product-breadcrumb">
        <div class="container">
            <nav aria-label="Đường dẫn">
                <a href="/">Trang chủ</a>
                <i class="bx bx-chevron-right"></i>

                @if (Model.Category != null)
                {
                    <a href="/danh-muc/@Model.Category.Alias-@Model.Category.Id">
                        @Model.Category.Name
                    </a>
                    <i class="bx bx-chevron-right"></i>
                }

                <span>@Model.Name</span>
            </nav>
        </div>
    </section>

    <section class="product-hero">
        <div class="container">
            @if (TempData["CartError"] != null)
            {
                <div class="product-alert">
                    <i class="bx bx-error-circle"></i>
                    @TempData["CartError"]
                </div>
            }

            <div class="product-card">
                <div class="product-visual reveal-item">
                    @if (hasSale)
                    {
                        <span class="sale-badge">
                            -@discount%
                        </span>
                    }

                    <div class="image-frame">
                        <img src="@imageUrl"
                             alt="@Model.Name"
                             id="productImage"
                             onerror="this.onerror=null;this.src='/Content/Client/img/error.png';" />
                    </div>
                </div>

                <div class="product-summary reveal-item">
                    <div class="eyebrow">
                        SẢN PHẨM KỸ THUẬT SỐ
                    </div>

                    <h1>@Model.Name</h1>

                    <div class="rating-row">
                        <span>Giao code tự động</span>
                        <span class="dot"></span>
                        <span>Mã SP: KSP@(Model.Id)</span>
                    </div>

                    <div class="price-panel">
                        <span class="current-price">
                            @BBEcom.Common.CommonHelper.ConvertMoney(currentPrice)đ
                        </span>

                        @if (hasSale)
                        {
                            <span class="original-price">
                                @BBEcom.Common.CommonHelper.ConvertMoney(Model.Price)đ
                            </span>

                            <span class="saving">
                                Tiết kiệm
                                @BBEcom.Common.CommonHelper.ConvertMoney(Model.Price - currentPrice)đ
                            </span>
                        }
                    </div>

                    <p class="product-lead">
                        Nhận mã sản phẩm sau khi thanh toán thành công.
                        Code được lưu trong lịch sử mua hàng.
                    </p>

                    <div class="stock-line @(stock > 0 ? "in-stock" : "out-stock")">
                        <span class="stock-dot"></span>
                        @(stock > 0
                            ? "Còn hàng - " + stock + " code có sẵn"
                            : "Sản phẩm tạm hết hàng")
                    </div>

                    @if (isLoggedIn)
                    {
                        using (Html.BeginForm(
                            "AddItem",
                            "Cart",
                            FormMethod.Post,
                            new
                            {
                                @class = "purchase-box",
                                id = "addToCartForm"
                            }))
                        {
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="productID"
                                   value="@Model.Id" />

                            <div class="quantity-wrap">
                                <label for="productQuantity">
                                    Số lượng
                                </label>

                                <div class="quantity-control">
                                    <button type="button"
                                            data-action="minus"
                                            aria-label="Giảm số lượng">
                                        <i class="bx bx-minus"></i>
                                    </button>

                                    <input id="productQuantity"
                                           name="quantity"
                                           type="number"
                                           value="1"
                                           min="1"
                                           max="@Math.Max(stock, 1)"
                                           inputmode="numeric" />

                                    <button type="button"
                                            data-action="plus"
                                            aria-label="Tăng số lượng">
                                        <i class="bx bx-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="purchase-actions">
                                <button type="submit"
                                        class="add-cart-btn secondary-buy-btn"
                                        @(stock < 1 ? "disabled" : null)>
                                    <i class="bx bx-cart-add"></i>
                                    <span>Thêm vào giỏ</span>
                                </button>

                                <button type="submit"
                                        formaction="@Url.Action("BuyNow", "Cart")"
                                        class="add-cart-btn buy-now-btn"
                                        @(stock < 1 ? "disabled" : null)>
                                    <i class="bx bx-bolt-circle"></i>
                                    <span>Mua ngay</span>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="purchase-box login-purchase-box">
                            <a class="add-cart-btn login-buy-btn"
                               href="@Url.Action(
                                   "Index",
                                   "Login",
                                   new { returnUrl = productUrl })">
                                <i class="bx bx-log-in-circle"></i>
                                <span>Đăng nhập để mua</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="product-information">
        <div class="container">
            <div class="info-layout">
                <article class="detail-content reveal-item">
                    <div class="section-heading">
                        <span>THÔNG TIN SẢN PHẨM</span>
                        <h2>Chi tiết và hướng dẫn sử dụng</h2>
                    </div>

                    <div class="rich-description">
                        @if (!String.IsNullOrWhiteSpace(Model.Detail))
                        {
                            @Html.Raw(Model.Detail)
                        }
                        else
                        {
                            <p>
                                Thông tin chi tiết đang được cập nhật.
                            </p>
                        }
                    </div>
                </article>

                <aside class="buy-guide reveal-item">
                    <h3>Quy trình nhận code</h3>
                    <ol>
                        <li>
                            <span>1</span>
                            <div>
                                <strong>Chọn sản phẩm</strong>
                                <p>Chọn đúng số lượng cần mua.</p>
                            </div>
                        </li>
                        <li>
                            <span>2</span>
                            <div>
                                <strong>Xác nhận giỏ hàng</strong>
                                <p>Kiểm tra giá và số lượng.</p>
                            </div>
                        </li>
                        <li>
                            <span>3</span>
                            <div>
                                <strong>Thanh toán QR</strong>
                                <p>Nhận code sau khi SePay xác nhận.</p>
                            </div>
                        </li>
                    </ol>
                </aside>
            </div>
        </div>
    </section>
</main>

@section jsFooter {
    <script src="/Content/Client/js/product-detail.js?v=20260725-2"></script>
}
