@model PagedList.IPagedList<Models.EF.Product>
@using PagedList.Mvc

@{
    ViewBag.Title = "Tìm kiếm sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var keyword =
        ViewBag.Keyword as string
        ?? String.Empty;

    var sort =
        ViewBag.Sort as string
        ?? "latest";

    var pageSize =
        ViewBag.PageSize == null
            ? 12
            : Convert.ToInt32(ViewBag.PageSize);
}

<link rel="stylesheet"
      href="@Url.Content("~/Content/Client/css/storefront-part1.css?v=20260801-1")" />

<div class="page-title-area">
    <div class="container">
        <div class="page-title-content">
            <h1>Tìm kiếm sản phẩm</h1>
            <ul>
                <li>
                    <a href="@Url.Action("Index", "Home")">
                        Trang chủ
                    </a>
                </li>
                <li>Tìm kiếm</li>
            </ul>
        </div>
    </div>
</div>

<section class="products-area ptb-100">
    <div class="container">
        <div class="storefront-toolbar">
            <div>
                @if (!String.IsNullOrWhiteSpace(keyword))
                {
                    <span>
                        Tìm thấy
                        <strong>@Model.TotalItemCount</strong>
                        sản phẩm cho “<strong>@keyword</strong>”.
                    </span>
                }
                else
                {
                    <span>
                        Có
                        <strong>@Model.TotalItemCount</strong>
                        sản phẩm đang bán.
                    </span>
                }
            </div>

            @using (Html.BeginForm(
                "Search",
                "Product",
                FormMethod.Get,
                new { id = "searchSortForm" }))
            {
                <input type="hidden"
                       name="keyword"
                       value="@keyword" />

                <div class="toolbar-controls">
                    <label for="sort">Sắp xếp</label>
                    <select id="sort"
                            name="sort"
                            onchange="this.form.submit()">
                        <option value="latest"
                                @(sort == "latest" ? "selected" : "")>
                            Mới nhất
                        </option>
                        <option value="price_asc"
                                @(sort == "price_asc" ? "selected" : "")>
                            Giá thấp đến cao
                        </option>
                        <option value="price_desc"
                                @(sort == "price_desc" ? "selected" : "")>
                            Giá cao đến thấp
                        </option>
                        <option value="name_asc"
                                @(sort == "name_asc" ? "selected" : "")>
                            Tên A–Z
                        </option>
                        <option value="sale"
                                @(sort == "sale" ? "selected" : "")>
                            Đang giảm giá
                        </option>
                    </select>

                    <label for="pageSize">Hiển thị</label>
                    <select id="pageSize"
                            name="pageSize"
                            onchange="this.form.submit()">
                        @foreach (var size in new[] { 8, 12, 16, 24 })
                        {
                            <option value="@size"
                                    @(pageSize == size ? "selected" : "")>
                                @size
                            </option>
                        }
                    </select>
                </div>
            }
        </div>

        <div id="storefrontAntiForgery" class="d-none">
            @Html.AntiForgeryToken()
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row justify-content-center">
                @foreach (var item in Model)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6">
                        @Html.Partial("_ProductCard", item)
                    </div>
                }
            </div>

            if (Model.PageCount > 1)
            {
                <div class="storefront-pagination">
                    @Html.PagedListPager(
                        Model,
                        page => Url.Action(
                            "Search",
                            "Product",
                            new
                            {
                                keyword = keyword,
                                sort = sort,
                                page = page,
                                pageSize = pageSize
                            }
                        )
                    )
                </div>
            }
        }
        else
        {
            <div class="empty-storefront">
                <i class="bx bx-search-alt"></i>
                <h3>Không tìm thấy sản phẩm phù hợp</h3>
                <p>Thử từ khóa ngắn hơn hoặc chọn danh mục khác.</p>
            </div>
        }
    </div>
</section>
