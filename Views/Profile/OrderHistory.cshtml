@model IEnumerable<Models.EF.Order>
@{
    ViewBag.Title = "Lịch sử mua hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var orders = (Model ?? Enumerable.Empty<Models.EF.Order>()).ToList();
    var completed = orders.Count(x => x.Status);
}
<link rel="stylesheet" href="@Url.Content("~/Content/Client/css/checkout-history.css?v=20260725-2")" />

<main class="flow-page history-page">
    <div class="container">
        <nav class="flow-breadcrumb"><a href="@Url.Content("~/")">Trang chủ</a><i class="bx bx-chevron-right"></i><span>Lịch sử mua hàng</span></nav>
        <header class="flow-heading">
            <div><span class="flow-eyebrow">TÀI KHOẢN CỦA TÔI</span><h1>Lịch sử mua hàng</h1><p>Theo dõi trạng thái và lấy code đã mua tại một nơi.</p></div>
            <a class="continue-shopping" href="@Url.Content("~/")"><i class="bx bx-store"></i>Tiếp tục mua sắm</a>
        </header>
        <section class="history-stats"><div><i class="bx bx-receipt"></i><span><strong>@orders.Count</strong>Tổng đơn hàng</span></div><div><i class="bx bx-check-circle"></i><span><strong>@completed</strong>Đã hoàn tất</span></div><div><i class="bx bx-key"></i><span><strong>@orders.Where(x => x.Status).Sum(x => x.OrderDetail.Count)</strong>Code đã mua</span></div></section>

        @if (orders.Any())
        {
            <section class="order-list">
                @foreach (var order in orders)
                {
                    <article class="order-card">
                        <header><div><small>Mã đơn hàng</small><h2>#@order.OrderCode</h2></div><div class="order-meta"><span><i class="bx bx-calendar"></i>@order.CreatedDate.ToString("dd/MM/yyyy")</span><span class="status-badge @(order.Status ? "completed" : "pending")"><i class="bx @(order.Status ? "bx-check" : "bx-time-five")"></i>@(order.Status ? "Đã thanh toán" : "Chờ thanh toán")</span></div></header>
                        <div class="order-products">
                            @foreach (var detail in order.OrderDetail)
                            {
                                var productName =
                                    detail.Product == null
                                        ? "Sản phẩm"
                                        : detail.Product.Name;

                                var productImage =
                                    detail.Product == null
                                        ? BBEcom.Common.CommonHelper.VersionedImage(
                                            Url.Content("~/Content/Client/img/favicon.png")
                                          )
                                        : BBEcom.Common.CommonHelper.ResolveProductImage(
                                            detail.Product.Alias,
                                            detail.Product.Images
                                          );

                                <div class="history-product">
                                    <img src="@(Url.Content(Convert.ToString(productImage).StartsWith("/Content/", StringComparison.OrdinalIgnoreCase) ? "~" + Convert.ToString(productImage) : Convert.ToString(productImage)))"
                                         alt="@productName"
                                         loading="lazy"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/Content/Client/img/error.png")';" />
                                    <div><strong>@(detail.Product == null ? "Sản phẩm" : detail.Product.Name)</strong><span>@BBEcom.Common.CommonHelper.ConvertMoney(detail.Price)đ</span></div>
                                    @if (order.Status && !String.Equals(detail.Code, "PENDING", StringComparison.OrdinalIgnoreCase))
                                    {<button type="button" class="code-copy" data-code="@detail.Code" title="Sao chép code"><span>@detail.Code</span><i class="bx bx-copy"></i></button>}
                                    else
                                    {<span class="code-waiting"><i class="bx bx-hourglass"></i>Đang chờ cấp code</span>}
                                </div>
                            }
                        </div>
                        <footer><span>Tổng thanh toán</span><strong>@order.TotalAmount.ToString("N0")đ</strong></footer>
                    </article>
                }
            </section>
        }
        else
        {
            <section class="flow-card empty-state"><i class="bx bx-receipt"></i><h2>Bạn chưa có đơn hàng nào</h2><p>Đơn hàng và code sản phẩm sẽ xuất hiện tại đây.</p><a href="@Url.Content("~/")">Mua sản phẩm đầu tiên</a></section>
        }
    </div>
</main>

@section jsFooter {
<script>
document.querySelectorAll('.code-copy').forEach(function (button) {
    button.addEventListener('click', function () {
        var current = this;
        navigator.clipboard.writeText(current.dataset.code).then(function () {
            current.classList.add('copied');
            current.querySelector('i').className = 'bx bx-check';
            setTimeout(function () { current.classList.remove('copied'); current.querySelector('i').className = 'bx bx-copy'; }, 1600);
        });
    });
});
</script>
}
