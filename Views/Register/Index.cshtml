@model BBEcom.Models.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="/Content/Client/css/auth-part2.css?v=20260801-1" />

<div class="profile-authentication-area ptb-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-10">
                <div class="login-form auth-card">
                    <h2>TẠO TÀI KHOẢN</h2>

                    @using (Html.BeginForm(
                        "Register", "Register",
                        new { returnUrl = ViewBag.ReturnUrl },
                        FormMethod.Post, null))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="auth-two-columns">
                            <div class="form-group">
                                <label>Tên đăng nhập</label>
                                @Html.TextBoxFor(x => x.UserName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(x => x.UserName, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                <label>Họ và tên</label>
                                @Html.TextBoxFor(x => x.Name, new { @class = "form-control" })
                                @Html.ValidationMessageFor(x => x.Name, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            @Html.TextBoxFor(x => x.Email, new
                            {
                                @class = "form-control",
                                type = "email",
                                autocomplete = "email"
                            })
                            @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
                        </div>

                        <div class="auth-two-columns">
                            <div class="form-group">
                                <label>Mật khẩu</label>
                                @Html.PasswordFor(x => x.Password, new
                                {
                                    @class = "form-control",
                                    autocomplete = "new-password"
                                })
                                @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                <label>Nhập lại mật khẩu</label>
                                @Html.PasswordFor(x => x.ConfirmPassword, new
                                {
                                    @class = "form-control",
                                    autocomplete = "new-password"
                                })
                                @Html.ValidationMessageFor(x => x.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <button type="submit" class="auth-primary-btn">
                            Đăng ký
                        </button>
                    }

                    <p class="auth-bottom-link">
                        Đã có tài khoản? <a href="/dang-nhap">Đăng nhập</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
