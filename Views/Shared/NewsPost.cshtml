@model IEnumerable<Models.EF.News>

@if (Model != null)
{
    foreach (var item in Model)
    {
        var created =
            item.CreateDate.HasValue
                ? item.CreateDate.Value
                : DateTime.Now;

        var image =
            BBEcom.Common.CommonHelper.ResolveNewsImage(
                item.Alias,
                item.Title,
                item.Image
            );

        <div class="col-lg-4 col-md-6 news-column">
            <article class="single-blog-post clean-news-card">
                <div class="image">
                    <a href="/tin-tuc/@item.Alias-@item.Id"
                       class="d-block">

                        <img src="@image"
                             alt="@item.Title"
                             loading="lazy"
                             onerror="this.onerror=null;this.src='/Content/Client/img/error.png';" />
                    </a>
                </div>

                <div class="content">
                    <span class="date">
                        <span>@created.ToString("dd/MM")</span>
                        @created.ToString("yyyy")
                    </span>

                    <span class="category">TIN TỨC</span>

                    <h3>
                        <a href="/tin-tuc/@item.Alias-@item.Id">
                            @item.Title
                        </a>
                    </h3>
                </div>
            </article>
        </div>
    }
}
