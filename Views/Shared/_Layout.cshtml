@using System.Linq
@{
    var layoutCart = Session["CART_SESSION"] as System.Collections.Generic.List<BBEcom.Models.Cart>;
    var layoutCartCount = layoutCart == null ? 0 : layoutCart.Sum(x => x.Quantity);
    var currentKeyword = Convert.ToString(Request.QueryString["keyword"]);
    var currentUser = BBEcom.Common.Auth.CurrentUser.Get();
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="GiftToi - website mua gift card và mã sản phẩm số.">

    <link rel="stylesheet" href="/Content/Client/css/bootstrap.min.css">
    <link rel="stylesheet" href="/Content/Client/css/owl.carousel.min.css">
    <link rel="stylesheet" href="/Content/Client/css/owl.theme.default.min.css">
    <link rel="stylesheet" href="/Content/Client/css/magnific-popup.min.css">
    <link rel="stylesheet" href="/Content/Client/css/animate.min.css">
    <link rel="stylesheet" href="/Content/Client/css/rangeSlider.min.css">
    <link rel="stylesheet" href="/Content/Client/css/odometer.min.css">
    <link rel="stylesheet" href="/Content/Client/css/boxicons.min.css">
    <link rel="stylesheet" href="/Content/Client/css/slick.min.css">
    <link rel="stylesheet" href="/Content/Client/css/countrySelect.min.css">
    <link rel="stylesheet" href="/Content/Client/css/meanmenu.min.css">
    <link rel="stylesheet" href="/Content/Client/css/style.css">
    <link rel="stylesheet" href="/Content/Client/css/responsive.css">
    <link rel="stylesheet" href="/Content/Client/css/site-modern.css?v=20260730-1">

    <title>@ViewBag.Title | GiftToi - Gift Card Shop</title>

    <link rel="apple-touch-icon" sizes="180x180" href="/Content/Client/img/favicon_io/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/Content/Client/img/favicon_io/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/Content/Client/img/favicon_io/favicon-16x16.png">
    <link rel="manifest" href="/Content/Client/img/favicon_io/site.webmanifest">
</head>
<body>
    <div class="top-header-area">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-lg-4 col-md-4 col-sm-12">
                    <p>Mua gift card nhanh chóng – nhận mã sau khi thanh toán</p>
                </div>

                <div class="col-lg-5 col-md-5 col-sm-8">
                    <div class="search-box">
                        @using (Html.BeginForm("Search", "Product", FormMethod.Get))
                        {
                            <input type="text"
                                   name="keyword"
                                   class="input-search"
                                   value="@currentKeyword"
                                   placeholder="Tìm kiếm sản phẩm..."
                                   autocomplete="off"
                                   aria-label="Từ khóa tìm kiếm">
                            <button type="submit" aria-label="Tìm kiếm">
                                <i class="bx bx-search"></i>
                            </button>
                        }
                    </div>
                </div>

                <div class="col-lg-3 col-md-3 col-sm-4">
                    <p class="text-lg-end mb-0">
                        <i class="bx bx-support"></i> Hỗ trợ khách hàng 24/7
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="navbar-area">
        <div class="patoi-responsive-nav">
            <div class="container">
                <div class="patoi-responsive-menu">
                    <div class="logo">
                        <a href="@Url.Action("Index", "Home")">
                            <img src="/Content/Client/img/logo.png" alt="GiftToi">
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="patoi-nav">
            <div class="container-fluid">
                <nav class="navbar navbar-expand-md navbar-light">
                    <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                        <img src="/Content/Client/img/logo.png" alt="GiftToi">
                    </a>

                    <div class="collapse navbar-collapse mean-menu">
                        <ul class="navbar-nav">
                            @{ Html.RenderAction("NavbarMenu", "Layout"); }

                            @if (currentUser != null)
                            {
                                <li class="nav-item">
                                    <a href="/lich-su-mua-hang" class="nav-link">
                                        <i class="bx bx-history"></i> Lịch sử giao dịch
                                    </a>
                                </li>
                            }
                        </ul>

                        <div class="others-option">
                            <div class="d-flex align-items-center">
                                <ul>
                                    

                                    @if (currentUser != null)
                                    {
                                        <li>
                                            <a href="/trang-ca-nhan" title="Trang cá nhân">
                                                <i class="bx bx-user-circle"></i>
                                            </a>
                                        </li>

                                        if (currentUser.IsAdmin)
                                        {
                                            <li>
                                                <a href="/Admin" title="Trang quản trị">
                                                    <i class="bx bx-check-shield"></i>
                                                </a>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li>
                                            <a href="/dang-nhap" title="Đăng nhập">
                                                <i class="bx bx-log-in"></i>
                                            </a>
                                        </li>
                                    }

                                    <li>
                                        <a href="/gio-hang" class="position-relative" title="Giỏ hàng">
                                            <i class="bx bx-cart"></i>
                                            <span class="cart-count @(layoutCartCount > 0 ? "has-items" : "")">
                                                @layoutCartCount
                                            </span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </nav>
            </div>
        </div>

        <div class="others-option-for-responsive">
            <div class="container">
                <div class="dot-menu">
                    <div class="inner">
                        <div class="circle circle-one"></div>
                        <div class="circle circle-two"></div>
                        <div class="circle circle-three"></div>
                    </div>
                </div>

                <div class="container">
                    <div class="option-inner">
                        <div class="others-option">
                            <ul>
                                

                                @if (currentUser != null)
                                {
                                    <li>
                                        <a href="/lich-su-mua-hang" title="Lịch sử giao dịch">
                                            <i class="bx bx-history"></i>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="/trang-ca-nhan" title="Trang cá nhân">
                                            <i class="bx bx-user-circle"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a href="/dang-nhap" title="Đăng nhập">
                                            <i class="bx bx-log-in"></i>
                                        </a>
                                    </li>
                                }

                                <li>
                                    <a href="/gio-hang" class="position-relative" title="Giỏ hàng">
                                        <i class="bx bx-cart"></i>
                                        <span class="cart-count @(layoutCartCount > 0 ? "has-items" : "")">
                                            @layoutCartCount
                                        </span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @RenderBody()

    <footer class="footer-area">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="single-footer-widget">
                        <h3>TỔNG ĐÀI HỖ TRỢ</h3>
                        <ul class="footer-contact-info">
                            <li><span>Hotline:</span> <a href="tel:123456789">123456789</a></li>
                            <li><span>Tư vấn:</span> <a href="tel:0987654231">0987654231</a></li>
                            <li><span>Email:</span> <a href="mailto:support@gifttoi.vn">support@gifttoi.vn</a></li>
                            <li><span>Địa chỉ:</span> Ngọc Hồi, Thanh Trì, Hà Nội, Việt Nam</li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="single-footer-widget">
                        <h3>THÔNG TIN</h3>
                        <ul class="custom-links">
                            <li><a href="/gioi-thieu-ve-chung-toi">Giới thiệu về GiftToi</a></li>
                            <li><a href="/tin-tuc">Tin tức và hướng dẫn</a></li>
                            <li><a href="@Url.Action("Search", "Product")">Tất cả sản phẩm</a></li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-4 col-md-12 col-sm-12">
                    <div class="single-footer-widget">
                        <h3>THANH TOÁN AN TOÀN</h3>
                        <p>
                            <i class="bx bx-qr-scan"></i>
                            Thanh toán chuyển khoản QR qua SePay. Đơn hàng được kiểm tra trước khi cấp mã.
                        </p>
                        <p>
                            <i class="bx bx-lock-alt"></i>
                            Thông tin tài khoản và giao dịch được xử lý tại phía máy chủ.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="copyright-area">
            <div class="container">
                <p>
                    Copyright @DateTime.Now.Year <span>GiftToi</span>.
                    Design &amp; Developed by <a href="@Url.Action("Index", "Home")">GIFTTOI</a>
                </p>
            </div>
        </div>
    </footer>

    <div class="go-top"><i class="bx bx-upvote"></i></div>

    <script src="/Content/Client/js/jquery.min.js"></script>
    <script src="/Scripts/jquery.unobtrusive-ajax.js"></script>
    <script src="/Content/Client/js/bootstrap.bundle.min.js"></script>
    <script src="/Content/Client/js/magnific-popup.min.js"></script>
    <script src="/Content/Client/js/meanmenu.min.js"></script>
    <script src="/Content/Client/js/appear.min.js"></script>
    <script src="/Content/Client/js/countrySelect.min.js"></script>
    <script src="/Content/Client/js/odometer.min.js"></script>
    <script src="/Content/Client/js/loopcounter.js"></script>
    <script src="/Content/Client/js/owl.carousel.min.js"></script>
    <script src="/Content/Client/js/rangeSlider.min.js"></script>
    <script src="/Content/Client/js/slick.min.js"></script>
    <script src="/Content/Client/js/form-validator.min.js"></script>
    <script src="/Content/Client/js/contact-form-script.js"></script>
    <script src="/Content/Client/js/ajaxchimp.min.js"></script>
    <script src="/Content/Client/js/main.js"></script>
    <script src="/Content/Client/js/site-modern.js?v=20260807-hardening1"></script>

    <script>
        window.Toastify = window.Toastify || function (options) {
            return {
                showToast: function () {
                    var toast = document.createElement('div');
                    toast.className = 'site-toast';
                    toast.textContent = options.text || '';

                    if (options.style && options.style.background) {
                        toast.style.background = options.style.background;
                    }

                    document.body.appendChild(toast);
                    requestAnimationFrame(function () {
                        toast.classList.add('show');
                    });

                    setTimeout(function () {
                        toast.classList.remove('show');
                        setTimeout(function () {
                            toast.remove();
                        }, 250);
                    }, options.duration || 3000);
                }
            };
        };
    </script>

    @RenderSection("jsFooter", required: false)
</body>
</html>


