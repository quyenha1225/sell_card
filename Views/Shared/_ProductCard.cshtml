@using System.Linq
@model Models.EF.Product

@{
    var hasSale =
        BBEcom.Common.CommonHelper.HasValidSale(Model);

    var displayPrice =
        BBEcom.Common.CommonHelper.GetSellingPrice(Model);

    var stock =
        Model.Giftcard == null
            ? 0
            : Model.Giftcard.Count(x =>
                x.ProductId == Model.Id
            );

    var imageUrl =
        BBEcom.Common.CommonHelper.ResolveProductImage(
            Model.Alias,
            Model.Images
        );
}

<article class="single-products-box modern-product-card clean-product-card">
    <div class="image">
        @if (!hasSale)
        {
            <span class="store-new-badge">
                MỚI
            </span>
        }

        <a href="@Url.Content("~/san-pham/" + Model.Alias + "-" + Model.Id)"
           class="product-image-link">

            <img src="@(Url.Content(Convert.ToString(imageUrl).StartsWith("/Content/", StringComparison.OrdinalIgnoreCase) ? "~" + Convert.ToString(imageUrl) : Convert.ToString(imageUrl)))"
                 alt="@Model.Name"
                 loading="lazy"
                 onerror="
                    this.onerror=null;
                    this.src='@Url.Content("~/Content/Client/img/error.png")';
                 " />
        </a>
    </div>

    <div class="content">
        <div class="product-card-meta">
            <span>
                @(Model.Category == null
                    ? "Gift Card"
                    : Model.Category.Name)
            </span>
        </div>

        <h3>
            <a href="@Url.Content("~/san-pham/" + Model.Alias + "-" + Model.Id)">
                @Model.Name
            </a>
        </h3>

        <div class="product-card-bottom">
            <div class="price">
                <span class="new-price">
                    @BBEcom.Common.CommonHelper.ConvertMoney(displayPrice)đ
                </span>

                @if (hasSale)
                {
                    <span class="old-price">
                        @BBEcom.Common.CommonHelper.ConvertMoney(Model.Price)đ
                    </span>
                }
            </div>

            <span class="stock-mini @(stock > 0 ? "" : "sold-out")">
                @(stock > 0 ? "Còn hàng" : "Hết hàng")
            </span>
        </div>

        <div class="product-card-cta">
            <a class="detail-card-btn"
               href="@Url.Content("~/san-pham/" + Model.Alias + "-" + Model.Id)">

                <i class="bx bx-show"></i>
                <span>Xem chi tiết</span>
            </a>

            @if (stock > 0)
            {
                <button type="button"
                        class="cart-card-btn js-quick-add"
                        data-product-id="@Model.Id">

                    <i class="bx bx-cart-add"></i>
                    <span>Thêm vào giỏ</span>
                </button>
            }
            else
            {
                <button type="button"
                        class="cart-card-btn"
                        disabled>

                    <i class="bx bx-x-circle"></i>
                    <span>Hết hàng</span>
                </button>
            }
        </div>
    </div>
</article>